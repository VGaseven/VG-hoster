{
  "name": "rasd",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RASD | رصد — 3D road-closure coordination & simulation prototype (Naqlthon 5)",
  "scripts": {
    "dev": "concurrently -k -n web,render -c cyan,magenta \"vite\" \"tsx server/render-server.ts\"",
    "dev:web": "vite",
    "render-server": "tsx server/render-server.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "video:preview": "remotion studio video/index.ts",
    "export-sim": "tsx scripts/export-sim.ts",
    "data:fetch-osm": "tsx scripts/fetch-osm.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.2.6",
    "@mapbox/mapbox-gl-rtl-text": "^0.3.0",
    "@remotion/player": "^4.0.499",
    "@turf/turf": "^7.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "maplibre-gl": "^5.9.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.4",
    "recharts": "^3.2.1",
    "remotion": "^4.0.499",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@remotion/bundler": "^4.0.499",
    "@remotion/cli": "^4.0.499",
    "@remotion/renderer": "^4.0.499",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.18.10",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
}
