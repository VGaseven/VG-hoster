# --- API (apps/api) ---
DATABASE_URL=postgres://madar:madar@localhost:5432/madar
PORT=4000
# 32 حرفًا على الأقل؛ إلزامي في الإنتاج
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
WEB_ORIGIN=http://localhost:3000
# الدخول التجريبي بالبريد (معطّل تلقائيًا عند NODE_ENV=production ما لم يُضبط true)
AUTH_DEV_LOGIN=true

# Google Maps Routes API — بدونه يعمل مدار بتقدير احتياطي تقريبي موسوم بذلك
GOOGLE_MAPS_API_KEY=
# مدة الاحتفاظ المؤقت بالتقديرات (دقائق) ثم تُحذف
ESTIMATE_CACHE_TTL_MIN=60

# تسجيل الدخول بحساب الجهة (OIDC)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback

# API الموارد البشرية (اختياري؛ يعيد مصفوفة JSON بحقول ملف HR)
HR_API_URL=
HR_API_TOKEN=

# Webhook لإرسال التذكيرات (بريد/SMS/تطبيق الجهة). بدونه تُسجَّل في السجل فقط
REMINDER_WEBHOOK_URL=

# --- Web (apps/web) ---
API_URL=http://localhost:4000
