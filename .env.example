# Required
BRIDGE_TOKEN=pick-a-long-random-secret

# Who does the AI thinking:
#   subscription (default) = Claude Code and Codex on this computer, signed in with your Claude and ChatGPT plans. No API bill.
#                            Sign in once: run `claude` then /login, and `codex login` → Sign in with ChatGPT.
#   api                    = pay per message with the keys below.
AI_ENGINE=subscription
# Optional: pick models, cap parallel jobs, and how long a plan that hit its limit rests before it's tried first again
CLAUDE_MODEL=
CODEX_MODEL=
CLI_MAX_PARALLEL=2
CLI_TIMEOUT_MIN=10
LIMIT_COOLDOWN_MIN=30
# Only used when AI_ENGINE=api (subscription mode never sends them to Claude Code or Codex)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Claude Code worker (GitHub)
# Fine-grained token with Issues: read/write on GITHUB_REPO
GITHUB_TOKEN=
GITHUB_REPO=VGaseven/your-website-repo
# Same secret as in the repo's webhook settings
GITHUB_WEBHOOK_SECRET=
# 0 = only send to Claude Code when someone calls dispatch_task
AUTO_DISPATCH=1

# Telegram remote control (approve buttons, /status, /pause, /resume)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only for group chats: user ids allowed to approve, comma-separated
TELEGRAM_ADMIN_IDS=

# n8n: JSON of name -> webhook url, or name -> {"url": "...", "description": "..."}
N8N_WORKFLOWS={}
# Sent as the X-Bridge-Secret header; check it with n8n Header Auth
N8N_WEBHOOK_SECRET=
# Lets every agent build and run n8n workflows through the bridge (n8n → Settings → n8n API)
N8N_API_KEY=
N8N_API_URL=http://localhost:5678

# Guard rails
DAILY_BUDGET_USD=5
REQUIRE_APPROVAL=forget,delete_file,create_schedule,delete_task,trigger_workflow
NOTIFY_ACTIONS=save_project,set_role,save_skill,import_memories,set_schedule_enabled,dispatch_task
MAX_AI_CALLS_PER_MIN=20
CLAIM_TTL_MIN=120
TZ=Asia/Riyadh
# 0 if the server is reached directly, without Render/Railway/Fly in front
TRUST_PROXY=1
