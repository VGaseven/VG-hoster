# RASD | رصد — optional providers. Everything works offline without these.
# Never put secret server keys here: VITE_* values are bundled into client code.

# Online vector basemap (MapLibre style JSON). Defaults to OpenFreeMap (no key required).
# Set to "offline" to always use the built-in offline digital-twin style.
VITE_BASEMAP_DARK=https://tiles.openfreemap.org/styles/dark
VITE_BASEMAP_LIGHT=https://tiles.openfreemap.org/styles/positron

# Satellite raster tiles ({z}/{x}/{y}). Only enable with a provider whose terms permit your use.
# Example: VITE_SATELLITE_TILES=https://your-provider.example/tiles/{z}/{x}/{y}.jpg?key=PUBLIC_KEY
VITE_SATELLITE_TILES=
VITE_SATELLITE_ATTRIBUTION=

# Terrain-RGB / Terrarium DEM tiles for optional elevation.
VITE_TERRAIN_TILES=
VITE_TERRAIN_ENCODING=terrarium

# Optional OSRM endpoint used only for the citizen-journey "external routing" comparison.
# Leave empty to use the built-in local network router (simulation).
VITE_OSRM_URL=

# Local render worker port (server/render-server.ts)
RASD_RENDER_PORT=3210
# Optional: Chrome/Chromium binary for Remotion rendering (auto-detected otherwise)
REMOTION_BROWSER=
